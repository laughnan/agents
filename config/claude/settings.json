{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "theme": "auto",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__AGENTS_HOME__/hooks/github-post-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__AGENTS_HOME__/hooks/guard-generated-config.sh"
          }
        ]
      }
    ]
  }
}
