{
  "attribution": {
    "pr": "— 👶 bébé, alex's agent · approved by alex"
  },
  "theme": "auto",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; git -C __AGENTS_HOME__ pull --ff-only -q && __AGENTS_HOME__/scripts/install >/dev/null; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__AGENTS_HOME__/hooks/agent-footer.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__AGENTS_HOME__/hooks/guard-generated-config.sh"
          }
        ]
      }
    ]
  }
}
