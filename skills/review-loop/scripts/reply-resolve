#!/usr/bin/env bash
# Reply on review threads and resolve them, from a JSON file:
#   [{"thread": "PRRT_…", "comment": 123, "body": "…"}, …]
# Every body must end with the agent footer (read from hooks/agent-footer.sh).
# This posts without the footer hook's prompt, so run it only after the user
# approved replying on this PR.
#
#   reply-resolve <pr-number> <replies.json> [owner/repo]
set -euo pipefail
pr=${1:?usage: reply-resolve <pr-number> <replies.json> [owner/repo]}
file=${2:?usage: reply-resolve <pr-number> <replies.json> [owner/repo]}
repo=${3:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}
hook="$(cd "$(dirname "$0")/../../.." && pwd)/hooks/agent-footer.sh"
footer=$(sed -n 's/^FOOTER="\(.*\)"$/\1/p' "$hook")
[[ -n "$footer" ]] || { echo "error: no FOOTER in $hook" >&2; exit 1; }

python3 - "$file" "$footer" <<'PY' || exit 1
import json,sys
items=json.load(open(sys.argv[1])); footer=sys.argv[2]
bad=[i.get("comment") for i in items if not i.get("body","").rstrip().endswith(footer)]
if bad: sys.exit(f"error: replies missing the footer line for comments {bad}")
PY

python3 - "$file" "$pr" "$repo" <<'PY'
import json,subprocess,sys
items=json.load(open(sys.argv[1])); pr,repo=sys.argv[2],sys.argv[3]
q="mutation($t:ID!){resolveReviewThread(input:{threadId:$t}){thread{isResolved}}}"
for i in items:
    r=subprocess.run(["gh","api","-X","POST",f"repos/{repo}/pulls/{pr}/comments/{i['comment']}/replies","-f",f"body={i['body']}","--jq",".id"],capture_output=True,text=True)
    if r.returncode: print(f"FAILED reply on {i['comment']}: {r.stderr.strip()[:200]}"); continue
    r2=subprocess.run(["gh","api","graphql","-f",f"query={q}","-f",f"t={i['thread']}","--jq",".data.resolveReviewThread.thread.isResolved"],capture_output=True,text=True)
    print(f"comment {i['comment']}: replied, resolved={r2.stdout.strip() or r2.stderr.strip()[:120]}")
PY
