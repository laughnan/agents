#!/usr/bin/env bash
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
"$repo/scripts/validate-skills"
"$repo/scripts/validate-agents"
for f in "$repo"/scripts/lib.sh "$repo"/scripts/install "$repo"/scripts/bootstrap "$repo"/scripts/doctor "$repo"/scripts/validate-skills "$repo"/scripts/validate-agents "$repo"/scripts/test-agents "$repo"/hooks/*.sh "$repo"/skills/*/scripts/*; do
  [[ -f "$f" ]] && bash -n "$f"
done
