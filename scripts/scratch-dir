#!/usr/bin/env bash
# Print this checkout's scratch directory, creating it if needed. Agents keep
# working files (handoffs, notes, drafts) here rather than inside the repo.
#
#   ~/agents/scratch/<checkout path relative to $HOME>/
#
# The checkout is the git worktree root, or the current directory outside git,
# so each worktree gets its own directory.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd -P)
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
case "$root" in
  "$HOME") key=_home ;;
  "$HOME"/*) key=${root#"$HOME"/} ;;
  *) key=_root$root ;;
esac

dir="$repo/scratch/$key"
mkdir -p "$dir"
printf '%s\n' "$dir"
