#!/usr/bin/env bash
# Wire this repo into the local agent harnesses. Idempotent: run after cloning,
# after `git pull`, and after editing config/ or local/.
#
#   scripts/install            apply
#   scripts/install --dry-run  show what would change
set -euo pipefail
source "$(dirname "$0")/lib.sh"

DRY=0
[[ "${1:-}" == "--dry-run" ]] && DRY=1
STAMP=$(date +%Y%m%d-%H%M%S)
warnings=0

say()  { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; warnings=$((warnings + 1)); }
act()  { if (( DRY )); then say "would: $*"; else "$@"; fi; }
did()  { (( DRY )) || say "$*"; }

backup() { # file: keep a copy of anything we're about to replace
  [[ -e "$1" || -L "$1" ]] || return 0
  act cp -P "$1" "$1.bak-agents-$STAMP"
  did "backed up $1 -> $1.bak-agents-$STAMP"
}

write_generated() { # target content
  local target=$1 content=$2
  if [[ -f "$target" && ! -L "$target" ]] && [[ "$(cat "$target")" == "$content" ]]; then
    say "ok      $target"
    return
  fi
  backup "$target"
  if (( DRY )); then say "would: write $target"; return; fi
  mkdir -p "$(dirname "$target")"
  rm -f "$target"
  printf '%s\n' "$content" > "$target.tmp.$$" && mv "$target.tmp.$$" "$target"
  say "wrote   $target"
}

command -v jq >/dev/null || { echo "error: jq is required" >&2; exit 1; }
[[ "$REPO" == "$HOME/agents" ]] || warn "repo is at $REPO, not ~/agents; hooks will point at $REPO"

# 1. Git hooks and validation
"$REPO/scripts/validate-skills"
"$REPO/scripts/validate-agents"
act git -C "$REPO" config core.hooksPath .githooks

# 2. Skills: flat per-skill symlinks into each harness's skill dir
for dest in "${SKILL_DESTS[@]}"; do
  act mkdir -p "$dest"
  while IFS= read -r src; do
    name=$(basename "$src")
    target="$dest/$name"
    if [[ -L "$target" ]]; then
      current=$(readlink "$target")
      [[ "$current" == "$src" ]] && continue
      case "$current" in
        "$REPO"/skills/*)
          act ln -sfn "$src" "$target"
          did "relinked $target" ;;
        *) warn "$target links to $current, not this repo; left alone (remove it and rerun to take it over)" ;;
      esac
    elif [[ -e "$target" ]]; then
      if diff -rq "$src" "$target" >/dev/null 2>&1; then
        act rm -rf "$target"
        act ln -s "$src" "$target"
        did "replaced identical copy $target"
      else
        warn "$target is a real directory that differs from the repo; left alone (move it aside and rerun)"
      fi
    else
      act ln -s "$src" "$target"
      did "linked  $target"
    fi
  done < <(skill_dirs)

  # Prune links into this repo whose skill no longer exists
  for link in "$dest"/*; do
    [[ -L "$link" ]] || continue
    case "$(readlink "$link")" in
      "$REPO"/skills/*) [[ -e "$link" ]] || { act rm "$link"; did "pruned  $link"; } ;;
    esac
  done
done

# Claude subagents: own only links into this repo, never real files or other links.
# Do not follow an externally managed directory symlink and write through it.
if [[ -L "$CLAUDE_AGENTS" || ( -e "$CLAUDE_AGENTS" && ! -d "$CLAUDE_AGENTS" ) ]]; then
  warn "$CLAUDE_AGENTS is not a real directory; left alone (move it aside and rerun)"
else
  act mkdir -p "$CLAUDE_AGENTS"
  while IFS= read -r src; do
    target="$CLAUDE_AGENTS/$(basename "$src")"
    if [[ -L "$target" ]]; then
      current=$(readlink "$target")
      [[ "$current" == "$src" ]] && continue
      if owned_agent_target "$current"; then
        act ln -sfn "$src" "$target"
        did "relinked $target"
      else
        warn "$target is not a managed agent link; left alone (move it aside and rerun)"
      fi
    elif [[ -e "$target" ]]; then
      warn "$target already exists; left alone (move it aside and rerun)"
    else
      act ln -s "$src" "$target"
      did "linked  $target"
    fi
  done < <(agent_files)
  for link in "$CLAUDE_AGENTS"/*.md; do
    [[ -L "$link" ]] || continue
    if owned_agent_target "$(readlink "$link")" && [[ ! -e "$link" ]]; then
      act rm "$link"
      did "pruned  $link"
    fi
  done
fi

# 3. Claude Code settings (generated) and global rules
settings=$(render_json_object render_claude_settings) \
  || { echo "error: config/claude/settings.json or local/claude.settings.json is not a valid JSON object; $CLAUDE_SETTINGS left untouched" >&2; exit 1; }
write_generated "$CLAUDE_SETTINGS" "$settings"
write_generated "$CLAUDE_MD" "$(render_claude_md)"

# 4. Codex global rules
if [[ -d "$HOME/.codex" ]]; then
  if [[ -f "$LOCAL_AGENTS_MD" ]]; then
    write_generated "$CODEX_AGENTS_MD" "$(render_codex_agents_md)"
  elif [[ "$(readlink "$CODEX_AGENTS_MD" 2>/dev/null)" != "$REPO/AGENTS.md" ]]; then
    backup "$CODEX_AGENTS_MD"
    act ln -sfn "$REPO/AGENTS.md" "$CODEX_AGENTS_MD"
    did "linked  $CODEX_AGENTS_MD"
  else
    say "ok      $CODEX_AGENTS_MD"
  fi

  if [[ -f "$CODEX_HOOKS" ]] && grep -qi orca "$CODEX_HOOKS"; then
    if codex_hooks=$(render_json_object strip_orca_codex_hooks); then
      write_generated "$CODEX_HOOKS" "$codex_hooks"
      did "removed Orca hooks from $CODEX_HOOKS"
    else
      warn "$CODEX_HOOKS is not valid JSON; left untouched"
    fi
  fi
fi


(( DRY )) && say "dry run: nothing changed"
(( warnings )) && say "$warnings warning(s); run scripts/doctor for details"
exit 0
